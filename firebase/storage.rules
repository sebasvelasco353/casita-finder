rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /casas/{casaId}/uploads/{fileName} {
      allow read: if false;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && firestore.get(/databases/(default)/documents/properties/$(casaId)).data.ownerId == request.auth.uid;
    }

    match /casas/{casaId}/images/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
